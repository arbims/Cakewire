{
    "name": "cakewire/cakewire",
    "description": "Live server-driven components for CakePHP powered by Alpine.js.",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "cakephp-plugin",
        "livewire",
        "alpinejs",
        "full-stack",
        "components"
    ],
    "homepage": "https://github.com/arbims/Cakewire",
    "license": "MIT",
    "authors": [
        {
            "name": "arbims",
            "homepage": "https://github.com/arbims"
        }
    ],
    "support": {
        "issues": "https://github.com/arbims/Cakewire/issues",
        "source": "https://github.com/arbims/Cakewire"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0",
        "cakephp/plugin-installer": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "CakeWire\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CakeWire\\Test\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "cakephp": {
            "plugin": "CakeWire\\CakeWirePlugin"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cakephp/plugin-installer": true
        }
    }
}
